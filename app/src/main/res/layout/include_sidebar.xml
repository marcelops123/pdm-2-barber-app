<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="56dp"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/btnSidebarMenu"
        style="@style/Widget.Pdm2.SidebarItem"
        android:contentDescription="Menu"
        android:src="@drawable/ic_menu_24" />

    <LinearLayout
        android:id="@+id/sidebarNavContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="8dp" />

    <View
        android:layout_width="32dp"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="@color/gray_stroke" />

    <ImageView
        android:id="@+id/btnSidebarSettings"
        style="@style/Widget.Pdm2.SidebarItem"
        android:contentDescription="Configurações"
        android:src="@drawable/ic_settings_24" />

    <ImageView
        android:id="@+id/btnSidebarLogout"
        style="@style/Widget.Pdm2.SidebarItem"
        android:contentDescription="Sair"
        android:src="@drawable/ic_logout_24"
        app:tint="@color/danger" />
</LinearLayout>
